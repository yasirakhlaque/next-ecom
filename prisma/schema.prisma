// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  name        String?     
  email       String      @unique
  password    String?     // Now optional for OAuth
  googleId    String?     // Stores Google's unique user ID (optional)
  image       String?
  role        Role        @default(CUSTOMER)
  address     String?

  // Remove the ID arrays and field/reference specifications for one-to-many relations
  wishlist       Wishlist[]
  cart           Cart[]
  orders         Order[]
  reviews        Review[]
  comments       Comment[]
  orderDetails   OrderDetails[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum Role {
  ADMIN
  CUSTOMER
}

model Product {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  image       String
  brand       String
  price       Float
  discount    Int?
  description String
  size        String
  category    String
  stock       Int
  rating      Float?
  
  // Remove the ID arrays and field/reference specifications for one-to-many relations
  reviews        Review[]
  comments       Comment[]
  wishlist       Wishlist[]
  cart           Cart[]
  orderDetails   OrderDetails[]
  
  adminId     String?    @db.ObjectId
  
  // Keep many-to-many relations with proper syntax
  tagIds         String[] @db.ObjectId
  tags           Tag[] @relation("ProductTags", fields: [tagIds], references: [id])
  
  categoryIds    String[] @db.ObjectId
  categories     Category[] @relation("ProductCategories", fields: [categoryIds], references: [id])
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Tag {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  name       String     @unique
  productIds String[]   @db.ObjectId
  products   Product[]  @relation("ProductTags", fields: [productIds], references: [id])
}

model Category {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  type       String
  productIds String[]   @db.ObjectId
  products   Product[]  @relation("ProductCategories", fields: [productIds], references: [id])
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  rating    Int
  text      String
  userId    String   @db.ObjectId
  productId String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  text      String
  likes     Int?     @default(0)
  dislikes  Int?     @default(0)
  userId    String   @db.ObjectId
  productId String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
}

model Wishlist {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  productId String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  
  @@unique([userId, productId]) // Prevent duplicates
}

model Cart {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  productId String   @db.ObjectId
  quantity  Int      @default(1)
  size      String?
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([userId, productId, size]) // Prevent duplicates for same product and size
}

model Order {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId
  userId         String     @db.ObjectId
  user           User       @relation(fields: [userId], references: [id])
  status         Status     @default(PENDING)
  totalAmount    Int
  address        String
  orderDetails   OrderDetails[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

enum Status {
  PENDING
  ACCEPTED
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderDetails {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId         String   @db.ObjectId
  productId       String   @db.ObjectId
  userId          String   @db.ObjectId
  quantity        Int
  priceAtPurchase Int
  size            String?

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id])
}